# Paste your Jev API key here. This file is a template; copy it to .env first.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# Optional reference model for the reproducible two-model benchmark (Anthropic).
REFERENCE_API_KEY=
REFERENCE_MODEL=claude-sonnet-4-5-20250929
# Required to enable paid live requests on a public deployment. Choose a private value.
LIVE_ACCESS_TOKEN=
# Publish a completed benchmark by copying its JSON to public/benchmark.json.
PORT=3001
